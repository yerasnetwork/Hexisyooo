# Supabase project (public URL + publishable key — safe to expose, access is
# controlled by RLS policies in supabase/migrations/0001_init.sql).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# AI plan generation. Any OpenAI-compatible chat-completions endpoint works
# (default candidate: NVIDIA NIM). Leave AI_API_KEY unset to use the
# deterministic local fallback planner instead of calling a model.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=meta/llama-3.1-8b-instruct
